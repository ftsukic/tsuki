{
  "name": "@ftsukic/tsuki",
  "version": "1.0.0-beta.1",
  "description": "基础 React Native UI 组件库。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ftsukic/tsuki.git",
    "directory": "packages/tsuki"
  },
  "bugs": {
    "url": "https://github.com/ftsukic/tsuki/issues"
  },
  "homepage": "https://github.com/ftsukic/tsuki#readme",
  "source": "src/index.ts",
  "main": "dist/commonjs/index.js",
  "module": "dist/module/index.js",
  "react-native": "dist/module/index.js",
  "types": "dist/typescript/commonjs/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/typescript/module/index.d.ts",
        "default": "./dist/module/index.js"
      },
      "import": {
        "types": "./dist/typescript/module/index.d.ts",
        "default": "./dist/module/index.js"
      },
      "require": {
        "types": "./dist/typescript/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./theme.css": "./dist/theme/theme.css",
    "./nativewind-v4-preset": {
      "require": "./dist/theme/nativewind-v4-preset.cjs",
      "default": "./dist/theme/nativewind-v4-preset.cjs"
    },
    "./nativewind-v5.css": "./dist/theme/nativewind-v5.css"
  },
  "files": [
    "assets",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": ">=19.2.3",
    "react-native": ">=0.86.0",
    "react-native-gesture-handler": ">=2.32.0 <3.0.0",
    "react-native-reanimated": ">=4.7.1 <5.0.0",
    "react-native-safe-area-context": ">=5.7.0 <6.0.0",
    "react-native-svg": ">=15.16.0",
    "react-native-worklets": ">=0.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bob build && node ../../scripts/copy-theme-assets.cjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest --config jest.config.cjs --runInBand",
    "release:check-package": "node ../../scripts/validate-package.cjs",
    "test:v2": "jest --config jest.v2.config.cjs --runInBand",
    "typecheck:fixtures": "tsc -p tsconfig.fixtures.json --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.29.10",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@shopify/flash-list": "2.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "0.44.1",
    "react-native-gesture-handler": "2.33.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-svg": "15.16.1",
    "react-native-teleport": "1.2.4",
    "react-native-worklets": "0.13.1",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3",
    "@ant-design/colors": "^8.0.1",
    "@ant-design/fast-color": "^3.0.1",
    "@ant-design/icons-svg": "^4.6.0",
    "react-native-popover-view": "^6.1.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "commonjs",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": "**/{__tests__/**,__fixtures__/**,__mocks__/**,*.md}"
  }
}
