{
  "name": "tsuki-workspace",
  "private": true,
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "pnpm --filter @ftsukic/tsuki run build",
    "fixtures:generate": "pnpm --filter playground run generate:fixtures",
    "typecheck": "pnpm run package:typecheck && pnpm run playground:typecheck",
    "package:typecheck": "pnpm --filter @ftsukic/tsuki run typecheck",
    "package:test": "pnpm --filter @ftsukic/tsuki run test",
    "playground:typecheck": "pnpm --filter playground run typecheck",
    "playground:test": "pnpm --filter playground run test",
    "playground:config": "pnpm --filter playground run config",
    "playground:build:development": "pnpm --filter playground run build:development",
    "playground:build": "pnpm --filter playground run build:native",
    "playground:dev": "pnpm --filter playground run start",
    "playground:ios": "pnpm --filter playground run ios",
    "playground:android": "pnpm --filter playground run android",
    "lint": "eslint packages/tsuki/src apps/playground --ext .ts,.tsx,.js,.cjs,.mjs && eslint eslint.config.mjs commitlint.config.mjs lint-staged.config.mjs packages/tsuki/*.cjs scripts/*.cjs",
    "test": "pnpm run package:test && pnpm run playground:test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint",
    "changeset": "changeset",
    "changeset:status": "node scripts/changeset-status.cjs",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "release:check-package": "pnpm --filter @ftsukic/tsuki run release:check-package",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@antfu/eslint-config": "10.0.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
