{
  "name": "playground",
  "main": "index.ts",
  "version": "1.0.0",
  "dependencies": {
    "@ftsukic/tsuki": "workspace:*",
    "@shopify/flash-list": "2.3.3",
    "expo": "~57.0.32",
    "expo-build-properties": "^57.0.23",
    "expo-constants": "~57.0.23",
    "expo-dev-client": "~57.0.21",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.30",
    "expo-splash-screen": "~57.0.11",
    "nativewind": "5.0.0-rc.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.1.0-rc.1",
    "react-native-gesture-handler": "~2.33.1",
    "react-native-keyboard-controller": "1.23.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.16.1",
    "react-native-teleport": "1.2.4",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@tailwindcss/postcss": "4.1.12",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-jest": "~29.7.0",
    "babel-preset-expo": "~57.0.16",
    "jest": "~29.7.0",
    "lightningcss": "1.30.1",
    "postcss": "8.5.6",
    "react-refresh": "^0.14.2",
    "tailwindcss": "4.1.12",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "generate:fixtures": "node ../../scripts/generate-fixture-catalog.cjs",
    "start": "pnpm run generate:fixtures && expo start",
    "android": "pnpm run generate:fixtures && expo run:android",
    "ios": "pnpm run generate:fixtures && expo run:ios",
    "typecheck": "tsc --noEmit",
    "config": "pnpm run generate:fixtures && expo config --type public",
    "build:development": "pnpm run generate:fixtures && expo export --dev --platform ios && expo export --dev --platform android",
    "build:native": "pnpm run generate:fixtures && expo export --platform ios && expo export --platform android",
    "test": "jest --config jest.config.cjs --runInBand"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-svg",
        "react-native-worklets",
        "react-native-keyboard-controller",
        "@shopify/flash-list"
      ]
    }
  }
}
