{
  "name": "example",
  "main": "index.ts",
  "version": "1.0.0",
  "dependencies": {
    "@shopify/flash-list": "2.3.2",
    "expo": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.22.4",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-svg": "~15.15.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "generate:fixtures": "node ../scripts/generate-fixture-catalog.cjs",
    "start": "yarn generate:fixtures && expo start",
    "android": "yarn generate:fixtures && expo run:android",
    "ios": "yarn generate:fixtures && expo run:ios",
    "web": "yarn generate:fixtures && expo start --web",
    "typecheck": "yarn generate:fixtures && tsc --noEmit",
    "config": "yarn generate:fixtures && expo config --type public",
    "export:web": "yarn generate:fixtures && expo export --platform web"
  },
  "private": true
}
